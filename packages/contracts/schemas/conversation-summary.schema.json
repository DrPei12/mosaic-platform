{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.internal/schemas/conversation-summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "product_model_id", "title", "preview", "updated_at"],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "product_model_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
