# Bundled production-shaped topology. This is intentionally not production.
# Copy this file to an operator-controlled env file for a staging drill.
MOSAIC_PROJECT_NAME=mosaic-staging
MOSAIC_APP_ENVIRONMENT=staging
MOSAIC_APP_VERSION=0.1.0
MOSAIC_IMAGE_TAG=staging
MOSAIC_API_IMAGE=mosaic-api:staging
MOSAIC_WEB_IMAGE=mosaic-web:staging

MOSAIC_POSTGRES_DB=mosaic
MOSAIC_POSTGRES_USER=mosaic_owner
MOSAIC_POSTGRES_PASSWORD=mosaic_owner_local
MOSAIC_APP_DB_USER=mosaic_app
MOSAIC_APP_DB_PASSWORD=mosaic_app_local
MOSAIC_WORKER_DB_USER=mosaic_worker
MOSAIC_WORKER_DB_PASSWORD=mosaic_worker_local
MOSAIC_OWNER_DATABASE_URL=postgresql+asyncpg://mosaic_owner:mosaic_owner_local@postgres:5432/mosaic
MOSAIC_API_DATABASE_URL=postgresql+asyncpg://mosaic_app:mosaic_app_local@postgres:5432/mosaic
MOSAIC_WORKER_DATABASE_URL=postgresql+asyncpg://mosaic_worker:mosaic_worker_local@postgres:5432/mosaic

MOSAIC_REDIS_PASSWORD=mosaic
MOSAIC_REDIS_URL=redis://:mosaic@redis:6379/0

MOSAIC_RABBITMQ_USER=mosaic
MOSAIC_RABBITMQ_PASSWORD=mosaic
MOSAIC_RABBITMQ_URL=amqp://mosaic:mosaic@rabbitmq:5672/

MOSAIC_ARTIFACT_STORAGE_S3_ENDPOINT_URL=http://minio:9000
MOSAIC_ARTIFACT_STORAGE_S3_SEED_ENDPOINT_URL=http://minio:9000
MOSAIC_ARTIFACT_STORAGE_S3_BUCKET=mosaic-artifacts
MOSAIC_ARTIFACT_STORAGE_S3_REGION=us-east-1
MOSAIC_ARTIFACT_STORAGE_S3_ACCESS_KEY_ID=minioadmin
MOSAIC_ARTIFACT_STORAGE_S3_SECRET_ACCESS_KEY=minioadmin

MOSAIC_AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
MOSAIC_SESSION_COOKIE_SECURE=false
MOSAIC_SESSION_TOKEN_PEPPER=REPLACE_WITH_32_CHAR_SESSION_TOKEN_PEPPER
MOSAIC_AUTH_REGISTRATION_ENABLED=false
MOSAIC_CHAT_SUBMISSION_ENABLED=true
MOSAIC_GENERATION_SUBMISSION_ENABLED=true
MOSAIC_METRICS_ENABLED=true
# Replace in the operator-controlled copy; do not commit the real value.
MOSAIC_METRICS_INTERNAL_TOKEN=REPLACE_WITH_32_CHAR_INTERNAL_METRICS_TOKEN
MOSAIC_WORKER_METRICS_ENABLED=true
MOSAIC_METRICS_BIND_HOST=0.0.0.0
MOSAIC_WORKER_METRICS_PORT=9090
MOSAIC_API_ORIGIN=http://api:8000
MOSAIC_WEB_BIND_ADDRESS=127.0.0.1
MOSAIC_WEB_PORT=3000

# A non-provider value is enough for readiness; no paid smoke is performed.
DASHSCOPE_API_KEY=REPLACE_WITH_PROVIDER_KEY_FROM_SECRET_INJECTOR

# Required only when producing or validating paid Provider activation evidence.
MOSAIC_LIVE_EVIDENCE_HMAC_KEY=REPLACE_WITH_32_CHAR_LIVE_EVIDENCE_HMAC_KEY

# Set only in the process environment when generating a local HMAC receipt.
MOSAIC_RELEASE_HMAC_KEY=REPLACE_WITH_LOCAL_RECEIPT_KEY
