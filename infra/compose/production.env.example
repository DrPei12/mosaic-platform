# Strict external production env. For the bundled HTTP/AMQP topology use
# staging.env.example instead. Replace every REPLACE_WITH value and never
# commit the filled file.
MOSAIC_APP_ENVIRONMENT=production
MOSAIC_APP_VERSION=0.1.0
MOSAIC_IMAGE_TAG=REPLACE_WITH_COMMIT_SHA
MOSAIC_API_IMAGE=registry.example.com/mosaic/api:REPLACE_WITH_COMMIT_SHA
MOSAIC_WEB_IMAGE=registry.example.com/mosaic/web:REPLACE_WITH_COMMIT_SHA

MOSAIC_POSTGRES_DB=mosaic
MOSAIC_POSTGRES_USER=mosaic_owner
MOSAIC_POSTGRES_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
MOSAIC_APP_DB_USER=mosaic_app
MOSAIC_APP_DB_PASSWORD=REPLACE_WITH_APP_PASSWORD
MOSAIC_WORKER_DB_USER=mosaic_worker
MOSAIC_WORKER_DB_PASSWORD=REPLACE_WITH_WORKER_PASSWORD
MOSAIC_OWNER_DATABASE_URL=postgresql+asyncpg://mosaic_owner:REPLACE_WITH_OWNER_PASSWORD@postgres:5432/mosaic
MOSAIC_API_DATABASE_URL=postgresql+asyncpg://mosaic_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/mosaic
MOSAIC_WORKER_DATABASE_URL=postgresql+asyncpg://mosaic_worker:REPLACE_WITH_WORKER_PASSWORD@postgres:5432/mosaic

MOSAIC_REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_REDIS_PASSWORD
MOSAIC_REDIS_URL=rediss://:REPLACE_WITH_A_RANDOM_REDIS_PASSWORD@redis.example.internal:6380/0

MOSAIC_RABBITMQ_USER=mosaic_release
MOSAIC_RABBITMQ_PASSWORD=REPLACE_WITH_A_RANDOM_RABBITMQ_PASSWORD
# Production requires an amqps endpoint backed by an operator-managed TLS
# certificate. The bundled RabbitMQ container is the topology/stateful-volume
# placeholder and is not a production TLS terminator by itself.
MOSAIC_RABBITMQ_URL=amqps://mosaic_release:REPLACE_WITH_A_RANDOM_RABBITMQ_PASSWORD@rabbitmq.example.internal:5671/

MOSAIC_ARTIFACT_STORAGE_S3_ENDPOINT_URL=https://minio.example.internal
MOSAIC_ARTIFACT_STORAGE_S3_SEED_ENDPOINT_URL=https://minio.example.internal
MOSAIC_ARTIFACT_STORAGE_S3_BUCKET=mosaic-artifacts
MOSAIC_ARTIFACT_STORAGE_S3_REGION=us-east-1
MOSAIC_ARTIFACT_STORAGE_S3_ACCESS_KEY_ID=REPLACE_WITH_A_RANDOM_S3_ACCESS_KEY
MOSAIC_ARTIFACT_STORAGE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_A_RANDOM_S3_SECRET_KEY
# The bundled MinIO container is available for topology and restore drills;
# production API settings require an HTTPS S3-compatible endpoint.

MOSAIC_AUTH_ALLOWED_ORIGINS=["https://app.example.com"]
MOSAIC_SESSION_COOKIE_SECURE=true
MOSAIC_SESSION_TOKEN_PEPPER=REPLACE_WITH_32_CHAR_SESSION_TOKEN_PEPPER
MOSAIC_CHAT_SUBMISSION_ENABLED=true
MOSAIC_GENERATION_SUBMISSION_ENABLED=true
MOSAIC_METRICS_ENABLED=true
# Replace through the operator secret store; never commit the real value.
MOSAIC_METRICS_INTERNAL_TOKEN=REPLACE_WITH_32_CHAR_INTERNAL_METRICS_TOKEN
MOSAIC_WORKER_METRICS_ENABLED=true
MOSAIC_METRICS_BIND_HOST=0.0.0.0
MOSAIC_WORKER_METRICS_PORT=9090
MOSAIC_API_ORIGIN=http://api:8000
MOSAIC_WEB_BIND_ADDRESS=127.0.0.1
MOSAIC_WEB_PORT=3000

# This is only read from the process environment by the API/worker images.
DASHSCOPE_API_KEY=REPLACE_WITH_PROVIDER_KEY_FROM_SECRET_INJECTOR

# Required only when producing or validating paid Provider activation evidence.
MOSAIC_LIVE_EVIDENCE_HMAC_KEY=REPLACE_WITH_32_CHAR_LIVE_EVIDENCE_HMAC_KEY

# Used by scripts/verify-release.ps1. It is never written to a receipt.
MOSAIC_RELEASE_HMAC_KEY=REPLACE_WITH_RELEASE_RECEIPT_HMAC_KEY
