APP_ENVIRONMENT=development
METRICS_ENABLED=true
METRICS_SERVER_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9090
# METRICS_INTERNAL_TOKEN=operator-injected-secret
DATABASE_URL=postgresql+asyncpg://mosaic:mosaic@127.0.0.1:5432/mosaic
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://mosaic:mosaic@127.0.0.1:5672/
RABBITMQ_CHAT_QUEUE=mosaic.chat.inference
RABBITMQ_GENERATION_QUEUE=mosaic.generation.execute
RABBITMQ_VIDEO_GENERATION_QUEUE=mosaic.generation.video.execute
CONCURRENCY_LEASE_SECONDS=120
CONCURRENCY_SATURATED_RETRY_DELAY_SECONDS=2
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_REGISTRATION_ENABLED=false
GENERATION_SUBMISSION_ENABLED=false
CHAT_SUBMISSION_ENABLED=false
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_STORAGE_S3_ENDPOINT_URL=http://127.0.0.1:9000
ARTIFACT_STORAGE_S3_BUCKET=mosaic-artifacts
ARTIFACT_STORAGE_S3_REGION=us-east-1
ARTIFACT_STORAGE_S3_ACCESS_KEY_ID=minioadmin
ARTIFACT_STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
ARTIFACT_STORAGE_S3_TIMEOUT_SECONDS=60
ARTIFACT_STORAGE_MAX_BYTES=209715200
ARTIFACT_STORAGE_PROVIDER_TIMEOUT_SECONDS=120
ARTIFACT_STORAGE_PROVIDER_ALLOWED_HOSTS=["assets.aliyuncs.com"]
ARTIFACT_STORAGE_PROVIDER_TRUST_ENV=false
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
